# Local LLM via Ollama — if unreachable or the model isn't pulled, the AI
# orchestrator falls back to canned responses instead of erroring.
# Run `ollama serve` (or use the docker-compose "ollama" service) and
# `ollama pull llama3.1` (or whatever model you set below) before first use.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
