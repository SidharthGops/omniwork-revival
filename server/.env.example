PORT=4000
MONGO_URI=mongodb+srv://sidharth-gopan:sidhgops@cluster0.hlwxexh.mongodb.net/?appName=Cluster0
JWT_SECRET=change-this-in-real-deployment
CLIENT_ORIGIN=http://localhost:5173

# Local LLM via Ollama — if unreachable or the model isn't pulled, the AI
# orchestrator falls back to canned responses instead of erroring.
# Run `ollama serve` (or use the docker-compose "ollama" service) and
# `ollama pull llama3.1` (or whatever model you set below) before first use.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Proactive companion scheduler — how often it scans, and how long an
# in-progress task can go untouched before the AI checks in. Lower these
# for a fast demo (e.g. 30000 / 60000 = scan every 30s, nudge after 1 min).
COMPANION_SCAN_INTERVAL_MS=300000
COMPANION_CHECKIN_THRESHOLD_MS=1800000

# Slack — optional. Create a Slack app with a Bot Token (scopes: chat:write,
# im:write), install it to your workspace, and set the token below. Leave
# blank to skip Slack entirely; every Slack call no-ops gracefully.
SLACK_BOT_TOKEN=

# Zoom — optional. Create a Server-to-Server OAuth app in the Zoom
# Marketplace (scope: user:read:user) and set the three values below. Used
# only to check whether someone is in a meeting, so the companion can skip
# a check-in instead of interrupting. Leave blank to skip Zoom entirely.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
